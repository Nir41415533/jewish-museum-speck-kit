# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the backend API server.
# Must match PORT set in backend/.env.
# The VITE_ prefix is required — Vite only exposes variables with this prefix
# to client-side code (import.meta.env.VITE_API_BASE_URL).
VITE_API_BASE_URL=http://localhost:3001
